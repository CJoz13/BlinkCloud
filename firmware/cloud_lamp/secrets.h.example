// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — never commit real credentials.

#pragma once

// WiFi. The lamp first tries WIFI_SSID_OPEN (an open / passwordless network),
// then falls back to WIFI_SSID + WIFI_PASSWORD (WPA2). Set WIFI_SSID_OPEN to ""
// to skip the open network entirely.
#define WIFI_SSID_OPEN "OPEN_NETWORK_SSID_OR_EMPTY"
#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// HiveMQ Cloud cluster (or any MQTT broker reachable over TLS on 8883).
// Create a free cluster at https://console.hivemq.cloud and paste its host below.
#define MQTT_SERVER   "YOUR_CLUSTER_ID.s1.eu.hivemq.cloud"
#define MQTT_PORT     8883
#define MQTT_USER     "YOUR_HIVEMQ_USERNAME"
#define MQTT_PASSWORD "YOUR_HIVEMQ_PASSWORD"

// This lamp's identity and its paired lamp's identity.
#define LAMP_ID       "lamp1"
#define OTHER_LAMP_ID "lamp2"

// POSIX TZ string for THIS lamp's physical location. Drives the on-screen clock
// and the local hour this lamp broadcasts to its partner's LED ring.
//   Vienna   (Europe/Vienna):   "CET-1CEST,M3.5.0,M10.5.0/3"
//   Michigan (America/Detroit): "EST5EDT,M3.2.0,M11.1.0"
#define LAMP_TZ "CET-1CEST,M3.5.0,M10.5.0/3"

// All of these are optional -- cloud_lamp.ino falls back to sane defaults if any
// are left undefined. Uncomment and edit to personalize this lamp.

// "Happy N years" banner on ANNIVERSARY_MONTH/ANNIVERSARY_DAY each year, where
// N = current year - ANNIVERSARY_START_YEAR. Both lamps should use the same date.
// #define ANNIVERSARY_MONTH      1   // 1-12
// #define ANNIVERSARY_DAY        2   // 1-31
// #define ANNIVERSARY_START_YEAR 2026

// Local hours during which the idle LED ring treats the *other* lamp as
// "daytime" for its sun/moon dial colors. Defaults: 7 and 20.
// #define DAY_START_HOUR 7
// #define DAY_END_HOUR   20

// Which physical NeoPixel sits at hour 0 (midnight) -- adjust to match how the
// ring is glued into the lid. Default: 0.
// #define HOUR_LED_OFFSET 0

// Startup LED brightness, 0-255. Default: 40. (Firmware caps at 120 regardless.)
// #define DEFAULT_BRIGHTNESS 40
